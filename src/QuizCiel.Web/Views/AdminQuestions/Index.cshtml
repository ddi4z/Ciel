@model QuestionListViewModel
@{
    ViewData["Title"] = $"Preguntas · {Model.CategoryName}";
}
<partial name="_AdminNav" />

<section class="panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h1 class="h4 m-0">@Model.CategoryName <span class="text-subtle h6">(nivel @Model.CategoryLevel)</span></h1>
        <a class="btn-app" href="/admin/categories/@Model.CategoryId/questions/create">Nueva pregunta</a>
    </div>
    <p class="text-subtle">
        Preguntas activas: <strong class="@(Model.ActiveQuestionCount >= GameRules.MinimumActiveQuestionsPerCategory ? "readiness-ok" : "readiness-missing")">@Model.ActiveQuestionCount</strong>
        (mínimo @GameRules.MinimumActiveQuestionsPerCategory). Las preguntas ya jugadas no se pueden editar: desactívalas y crea una nueva.
    </p>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Enunciado</th>
                    <th>Respuesta correcta</th>
                    <th>Veces jugada</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var questionSummary in Model.Questions)
                {
                    <tr class="@(questionSummary.IsActive ? string.Empty : "row-inactive")">
                        <td>@questionSummary.Text</td>
                        <td>@questionSummary.CorrectOptionText</td>
                        <td>@questionSummary.TimesPlayed</td>
                        <td>
                            <span class="status-badge @(questionSummary.IsActive ? "status-badge--success" : "status-badge--neutral")">
                                @(questionSummary.IsActive ? "Activa" : "Inactiva")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a class="btn-app btn-app--secondary btn-app--small" href="/admin/categories/@Model.CategoryId/questions/@questionSummary.Id/edit">
                                    @(questionSummary.TimesPlayed > 0 ? "Ver" : "Editar")
                                </a>
                                <form method="post" action="/admin/categories/@Model.CategoryId/questions/@questionSummary.Id/toggle" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="activate" value="@((!questionSummary.IsActive).ToString().ToLowerInvariant())" />
                                    <button type="submit" class="btn-app btn-app--small @(questionSummary.IsActive ? "btn-app--danger" : string.Empty)">
                                        @(questionSummary.IsActive ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
