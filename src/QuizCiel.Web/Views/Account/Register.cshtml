@model RegisterViewModel
@{
    ViewData["Title"] = "Registro";
}
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <section class="panel">
            <h1 class="h4 mb-1">Crear cuenta de jugador</h1>
            <p class="text-subtle small">Tu cédula te identifica para pagarte el premio. Cada cédula puede participar una sola vez.</p>
            <form method="post" action="/account/register">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>
                <div class="mb-3">
                    <label asp-for="DocumentNumber" class="form-label"></label>
                    <input asp-for="DocumentNumber" class="form-control" inputmode="numeric" autocomplete="off" autofocus />
                    <span asp-validation-for="DocumentNumber" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <div class="text-subtle small">@SpanishIdentityErrorDescriber.DescribePasswordPolicy()</div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
                <button type="submit" class="btn-app w-100">Registrarme</button>
            </form>
            <p class="small mt-3 mb-0">¿Ya tienes cuenta? <a href="/account/login">Ingresa</a></p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
