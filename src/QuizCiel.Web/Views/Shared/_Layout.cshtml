<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuizCiel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header mb-4">
        <div class="container d-flex align-items-center justify-content-between py-2">
            <a class="app-brand" href="/">QuizCiel</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" action="/account/logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link nav-link p-0">Cerrar sesión</button>
                </form>
            }
        </div>
    </header>

    <main role="main" class="container pb-4">
        <partial name="_FlashMessages" />
        @RenderBody()
    </main>

    <footer class="app-footer py-3">
        <div class="container small">QuizCiel · Prueba técnica Ciel · @DateTime.UtcNow.Year</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
