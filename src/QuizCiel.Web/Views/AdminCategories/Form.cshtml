@model CategoryFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Nueva categoría" : "Editar categoría";
}
<partial name="_AdminNav" />

<section class="panel">
    <h1 class="h4 mb-3">@ViewData["Title"]</h1>
    <form method="post" action="/admin/categories/save">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Level" class="form-label"></label>
                <select asp-for="Level" class="form-select">
                    @for (var level = GameRules.MinimumLevel; level <= GameRules.MaximumLevel; level++)
                    {
                        <option value="@level">Nivel @level</option>
                    }
                </select>
                <span asp-validation-for="Level" class="field-validation-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-app">Guardar</button>
            <a class="btn-app btn-app--secondary" href="/admin/categories">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
