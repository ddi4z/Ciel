@model List<QuizCiel.Web.Data.ReadModels.CategorySummary>
@{
    ViewData["Title"] = "Categorías";
}
<partial name="_AdminNav" />

<section class="panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 m-0">Categorías</h1>
        @if (Model.Count < GameRules.TotalRounds)
        {
            <a class="btn-app" href="/admin/categories/create">Nueva categoría</a>
        }
    </div>
    <p class="text-subtle">Cada categoría corresponde a un nivel de complejidad y alimenta la ronda con el mismo número.</p>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nivel</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Preguntas (activas / total)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var categorySummary in Model)
                {
                    <tr>
                        <td>@categorySummary.Level</td>
                        <td>@categorySummary.Name</td>
                        <td class="text-subtle">@categorySummary.Description</td>
                        <td>@categorySummary.ActiveQuestionCount / @categorySummary.TotalQuestionCount</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a class="btn-app btn-app--small" href="/admin/categories/@categorySummary.Id/questions">Preguntas</a>
                                <a class="btn-app btn-app--secondary btn-app--small" href="/admin/categories/@categorySummary.Id/edit">Editar</a>
                                @if (categorySummary.TotalQuestionCount == 0)
                                {
                                    <form method="post" action="/admin/categories/@categorySummary.Id/delete" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-app btn-app--danger btn-app--small"
                                                onclick="return confirm('¿Eliminar la categoría?');">Eliminar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
